// LinkedIn Agent — data model
// Standalone service. Own database. Not shared with SPEEDFI production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Brands
// ---------------------------------------------------------------------------

/// One row per LinkedIn Page the agent posts to. Voice and pillar definitions
/// live in code (src/brands/*.ts) so they are reviewable in git; this table
/// holds only what changes at runtime.
model Brand {
  id             String  @id @default(cuid())
  slug           String  @unique // "go3net" | "speedfi"
  displayName    String
  /// LinkedIn organization URN, e.g. "urn:li:organization:12345678".
  /// Null until the OAuth flow has run and the Page has been selected.
  organizationId String? @unique
  active         Boolean @default(true)

  /// Local time the agent aims to publish, e.g. "08:30". Africa/Lagos.
  preferredPostTime String @default("08:30")
  /// Days of week the agent generates for. 1 = Monday.
  postingDays       Int[]  @default([1, 2, 3, 4])

  token   LinkedInToken?
  pillars Pillar[]
  posts   Post[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

/// LinkedIn OAuth credentials. Access tokens last 60 days, refresh tokens 365.
/// Both columns hold ciphertext — encrypt with TOKEN_ENCRYPTION_KEY before
/// writing, never log them, never return them from an API route.
model LinkedInToken {
  id      String @id @default(cuid())
  brandId String @unique
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  accessTokenEnc  String
  refreshTokenEnc String?
  /// Scopes actually granted, so a missing permission surfaces at connect
  /// time rather than as a 403 at publish time.
  scopes          String[]
  expiresAt       DateTime
  refreshExpires  DateTime?
  /// Member who authorised the connection, for the audit trail.
  authorizedBy    String?
  lastRefreshedAt DateTime?
  /// Set when a refresh fails so the alert job can chase it.
  refreshFailedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Content planning
// ---------------------------------------------------------------------------

/// Content pillars with sampling weights. Seeded from src/brands/*.ts.
/// SPEEDFI: Business Education 30 / Product Education 25 /
/// Problem-Solution 20 / Customer Success 15 / Brand & Community 10.
model Pillar {
  id      String @id @default(cuid())
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  key    String // "business_education"
  name   String // "Business Education"
  /// Relative weight. The scheduler picks a pillar weighted by this, then
  /// penalises anything used in the last 5 posts so nothing dominates.
  weight Int
  /// Extra prompt context for this pillar only.
  brief  String?
  active Boolean @default(true)

  posts Post[]

  @@unique([brandId, key])
}

// ---------------------------------------------------------------------------
// Posts
// ---------------------------------------------------------------------------

enum PostStatus {
  DRAFT // generated, not yet sent to WhatsApp
  PENDING_APPROVAL // sent, awaiting reply
  CHANGES_REQUESTED // "edit: ..." received, queued for regeneration
  APPROVED // cleared to publish
  SCHEDULED // approved and has a publishAt in the future
  PUBLISHING // in-flight, guards against double posting
  PUBLISHED // live on LinkedIn
  FAILED // publish attempt exhausted retries
  DISCARDED // rejected outright
}

model Post {
  id      String @id @default(cuid())
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id])

  pillarId String?
  pillar   Pillar? @relation(fields: [pillarId], references: [id])

  status PostStatus @default(DRAFT)

  /// Post body as it will appear on LinkedIn, hashtags included.
  body    String
  /// Cloudinary URL. Uploaded to LinkedIn at publish time, since LinkedIn
  /// requires register-then-reference rather than a direct URL.
  imageUrl String?
  /// LinkedIn's image URN once registered. Cached to survive a retry.
  imageUrn String?

  /// Topic seed the generator worked from, so a regeneration stays on subject.
  sourceTopic String?
  /// Model that wrote it, for comparing output quality after a model change.
  model       String?

  scheduledFor DateTime?
  publishedAt  DateTime?

  /// URN returned by LinkedIn. Unique so a retry cannot create a duplicate.
  linkedinPostUrn String? @unique
  permalink       String?

  attempts     Int     @default(0)
  lastError    String?
  revisionOf   String? // previous Post.id when regenerated from feedback
  revisionRound Int    @default(0)

  approvals ApprovalEvent[]
  metrics   PostMetric?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId, status])
  @@index([status, scheduledFor])
}

// ---------------------------------------------------------------------------
// Approval trail
// ---------------------------------------------------------------------------

enum ApprovalAction {
  SENT
  APPROVED
  CHANGES_REQUESTED
  REJECTED
  TIMED_OUT
}

/// Every WhatsApp exchange about a post. Append-only — this is the record of
/// who authorised what, which is exactly what the privacy policy commits to.
model ApprovalEvent {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  action ApprovalAction
  /// WhatsApp number of the approver, stored hashed.
  actorHash String?
  /// Free text from an "edit: ..." reply.
  note      String?
  /// Cloud API message id, for correlating the reply to the draft.
  waMessageId String?

  createdAt DateTime @default(now())

  @@index([postId, createdAt])
}

// ---------------------------------------------------------------------------
// Analytics
// ---------------------------------------------------------------------------

/// Engagement pulled back from the Page analytics permission. Feeds the
/// generator so it can favour pillars that actually land.
model PostMetric {
  id     String @id @default(cuid())
  postId String @unique
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  impressions   Int @default(0)
  uniqueViews   Int @default(0)
  reactions     Int @default(0)
  comments      Int @default(0)
  shares        Int @default(0)
  clicks        Int @default(0)

  fetchedAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Operations
// ---------------------------------------------------------------------------

/// Cron run history. Cheap insurance — when a post silently fails to appear,
/// this tells you whether the job ran at all.
model JobRun {
  id       String    @id @default(cuid())
  job      String // "generate" | "publish" | "refresh_tokens" | "sync_metrics"
  startedAt DateTime @default(now())
  finishedAt DateTime?
  ok       Boolean?
  detail   String?

  @@index([job, startedAt])
}
