// LinkedIn Agent — data model
// Brands are seeded from src/brands/* (matched by slug); everything else is
// produced by the agent pipeline: idea -> draft -> approved -> scheduled ->
// published, with engagement snapshots captured after publishing.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Brand {
  id            String        @id @default(cuid())
  slug          String        @unique // "go3net" | "speedfi" — matches src/brands/<slug>.ts
  name          String
  linkedinOrgId String? // LinkedIn organization URN id; null until connected
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  ideas         ContentIdea[]
  posts         Post[]

  @@map("brands")
}

model ContentIdea {
  id        String     @id @default(cuid())
  brandId   String
  brand     Brand      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  pillar    String // content pillar key from the brand config
  topic     String
  angle     String? // the specific take/hook that makes this worth posting
  source    IdeaSource @default(AGENT)
  status    IdeaStatus @default(PROPOSED)
  createdAt DateTime   @default(now())

  posts     Post[]

  @@index([brandId, status])
  @@map("content_ideas")
}

model Post {
  id             String               @id @default(cuid())
  brandId        String
  brand          Brand                @relation(fields: [brandId], references: [id], onDelete: Cascade)
  ideaId         String?
  idea           ContentIdea?         @relation(fields: [ideaId], references: [id], onDelete: SetNull)

  pillar         String
  body           String // full post text, hashtags included (LinkedIn max 3000 chars)
  mediaUrl       String? // optional image/video asset
  mediaAltText   String?

  status         PostStatus           @default(DRAFT)
  scheduledAt    DateTime? // UTC; derived from the brand's posting slots
  publishedAt    DateTime?
  linkedinUrn    String?              @unique // e.g. urn:li:share:... once published
  failureReason  String? // populated when status = FAILED

  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  snapshots      EngagementSnapshot[]

  @@index([brandId, status])
  @@index([status, scheduledAt])
  @@map("posts")
}

model EngagementSnapshot {
  id          String   @id @default(cuid())
  postId      String
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  impressions Int      @default(0)
  reactions   Int      @default(0)
  comments    Int      @default(0)
  shares      Int      @default(0)
  clicks      Int      @default(0)

  capturedAt  DateTime @default(now())

  @@index([postId, capturedAt])
  @@map("engagement_snapshots")
}

model AgentRun {
  id         String    @id @default(cuid())
  stage      RunStage
  status     RunStatus @default(RUNNING)
  detail     String? // human-readable summary or error
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([stage, startedAt])
  @@map("agent_runs")
}

enum IdeaSource {
  AGENT // generated by the agent from content pillars
  HUMAN // suggested by a team member
}

enum IdeaStatus {
  PROPOSED
  APPROVED
  REJECTED
  USED
}

enum PostStatus {
  DRAFT
  APPROVED // human-approved, eligible for scheduling
  SCHEDULED
  PUBLISHED
  FAILED
  ARCHIVED
}

enum RunStage {
  IDEATE
  DRAFT
  SCHEDULE
  PUBLISH
  MEASURE
}

enum RunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}
