# See CLAUDE.md "Environment" — validate all of these at boot and fail loudly.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/linkedin_agent

ANTHROPIC_API_KEY=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
