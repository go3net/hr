# comma-separated allowlist of numbers that may approve posts
APPROVER_NUMBERS=

# 32-byte key, base64 (generate: openssl rand -base64 32)
TOKEN_ENCRYPTION_KEY=

CRON_SECRET=

CLOUDINARY_URL=
